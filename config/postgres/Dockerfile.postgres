# ============================================================
# Cyber Sentinel — Postgres 16 + pgvector + pg_cron
# ============================================================
# pgvector/pgvector:pg16 is built FROM the official postgres:16 image and
# already carries the PGDG apt repo, but does not bundle pg_cron. This
# adds it via the PGDG package.
#
# pg_cron additionally requires shared_preload_libraries='pg_cron' at
# postmaster startup — set by the `command:` override of the postgres_db
# service in docker-compose-cyber-sentinel.yml, since it's a runtime flag
# rather than an image-build concern.
# ============================================================

FROM pgvector/pgvector:pg16

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16-cron \
    && rm -rf /var/lib/apt/lists/*

# Trivy DS-0026 (no HEALTHCHECK defined). Same check as the one already
# defined at the compose level (docker-compose-cyber-sentinel.yml's
# postgres_db service) — that one takes precedence at runtime since
# compose-level healthcheck overrides an image's own HEALTHCHECK, so this
# is a static-scan fix / fallback, not a functional change.
HEALTHCHECK --interval=10s --timeout=5s --retries=10 \
    CMD pg_isready -U postgres -d cyber_intelligence || exit 1