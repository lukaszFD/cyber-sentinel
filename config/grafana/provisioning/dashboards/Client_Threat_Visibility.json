        {
          "datasource": { "type": "postgres", "uid": "PCF4C4661FE7E0A44" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    date_trunc('hour', timestamp) AS hour,\n    ROUND(100.0 * COUNT(*) FILTER (WHERE record_type = 'N/A') / NULLIF(COUNT(*), 0), 2) AS nxdomain_pct\nFROM cyber_sentinel.dns_queries\nWHERE $__timeFilter(timestamp)\n  AND query_type = 'reply'\nGROUP BY hour\nORDER BY hour ASC;",
          "refId": "A"
        }
      ],
      "title": "NXDOMAIN Rate — % of lookups that resolved to nothing",
      "type": "timeseries"
