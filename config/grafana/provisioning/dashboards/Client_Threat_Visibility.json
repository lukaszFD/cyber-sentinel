          "datasource": { "type": "postgres", "uid": "PCF4C4661FE7E0A44" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT domain, first_seen\nFROM (\n    SELECT domain, MIN(timestamp) AS first_seen\n    FROM cyber_sentinel.dns_queries\n    GROUP BY domain\n) fs\nWHERE $__timeFilter(first_seen)\nORDER BY first_seen DESC\nLIMIT 50;",
