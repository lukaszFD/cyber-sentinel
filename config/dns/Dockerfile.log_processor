# ============================================================
# Cyber Sentinel — dns_log_processor
# ============================================================
# Follows Pi-hole's query log (/var/log/pihole/pihole.log, bind-mounted
# read-only) and writes rows into cyber_sentinel.dns_queries.
# Postgres credentials come from .env (env_file in compose).
# Base image digest for reference: cs_base_images.dns_log_processor
# in ansible/group_vars/all/images.yml.
# ============================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir psycopg2-binary==2.9.10

COPY log_processor.py .

CMD ["python", "log_processor.py"]
