# Postgres
POSTGRES_ROOT_PASSWORD={{ vault_postgres_root_password }}
POSTGRES_HOST={{ postgres_host }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DATABASE={{ postgres_database }}

# Grafana pass
GRAFANA_PASSWORD={{ vault_grafana_password }}

# HashiCorp Vault
VAULT_ROOT_TOKEN={{ vault_root_token }}
# Vault Unseal Keys
VAULT_KEY1={{ vault_unseal_keys[0] }}
VAULT_KEY2={{ vault_unseal_keys[1] }}
VAULT_KEY3={{ vault_unseal_keys[2] }}

# open-webui (Hailo-10H inference UI)
WEBUI_SECRET_KEY={{ vault_webui_secret_key }}
WEBUI_ADMIN_EMAIL={{ webui_admin_email }}
WEBUI_ADMIN_PASSWORD={{ vault_webui_admin_password }}
WEBUI_ADMIN_NAME={{ webui_admin_name }}