# ============================================================
# Cyber Sentinel — .env template (rendered by playbook 01 [01.1.2])
# ============================================================
# Every variable used here must be listed in 01_setup_secrets.yml
# required_vars. Values are resolved by docker compose (${VAR}) and
# read directly by dns_log_processor (env_file: .env).
# ============================================================

# Postgres
POSTGRES_ROOT_PASSWORD={{ vault_postgres_root_password }}
POSTGRES_HOST={{ postgres_host }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DATABASE={{ postgres_database }}

# Grafana pass
GRAFANA_PASSWORD={{ vault_grafana_password }}

# AI config editor (ai-config-ui, playbook 04.5)
# Single quotes: docker compose keeps the value literal ($ in werkzeug
# hashes is not interpolated). A ' inside a UI password is emitted as
# ' so it cannot close the quote — still valid JSON for the app.
AI_UI_DB_USER={{ ai_config_db_user }}
AI_UI_DB_PASSWORD='{{ vault_ai_config_db_password }}'
AI_UI_SECRET_KEY='{{ vault_ai_ui_secret_key }}'
AI_UI_USERS='{{ vault_ai_ui_users | to_json | replace("'", "\\u0027") }}'
# Live lookups in the scoring simulator — same keys n8n uses (Vault
# cyber-sentinel/api-keys/virustotal and .../abuse/api-key).
AI_UI_VT_API_KEY='{{ vault_virus_total_token }}'
AI_UI_ABUSE_API_KEY='{{ vault_abuse_api_key }}'
