#!/bin/bash
# ============================================================
# Cyber Sentinel — Tranco allow-list weekly sync (delta)
# Generated by Ansible playbook 04_3c_tranco_allowlist.yml — do not edit
# on the host, changes are overwritten on the next deployment.
# ============================================================
# 1. Resolves the ID of the latest daily Tranco list (tries up to 3 days
#    back — the list for "yesterday" is sometimes published late).
# 2. Downloads ONLY the top N rows of that list as CSV. Falls back to the
#    full top-1m ZIP (latest list, no ID) if the ID endpoint is down.
# 3. Loads the rows into cyber_sentinel_ai.domain_allowlist_staging and
#    calls cyber_sentinel_ai.sp_sync_domain_allowlist(), which applies them
#    to the live table as a delta in one transaction (see db_ai_pipeline.sql,
#    Section 7b). The live table is never dropped or truncated.
#
# Exit codes: 0 = synced, 1 = download/load error, 2 = sync aborted by the
# database sanity guard (list too small). Output goes to the log file
# configured in the cron entry.
# ============================================================
set -euo pipefail

TOP_N="{{ tranco_top_n }}"
MIN_ROWS="{{ tranco_min_rows }}"
PG_CONTAINER="{{ tranco_pg_container }}"
PG_DB="{{ postgres_database }}"
TRANCO_BASE="https://tranco-list.eu"

LOCK_FILE="/run/cyber-sentinel-tranco-sync.lock"
WORK_DIR="$(mktemp -d /tmp/tranco-sync.XXXXXX)"
trap 'rm -rf "$WORK_DIR"' EXIT

log() { echo "$(date '+%Y-%m-%dT%H:%M:%S%z') [tranco-sync] $*"; }

psql_exec() {
    docker exec -i "$PG_CONTAINER" psql -U postgres -d "$PG_DB" \
        -v ON_ERROR_STOP=1 -X -q -At "$@"
}

# Only one sync at a time (cron + manual/Ansible run).
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    log "another sync is already running - skipping"
    exit 0
fi

log "start (top_n=$TOP_N, min_rows=$MIN_ROWS)"

# ------------------------------------------------------------
# Step 1 — latest list ID (alphanumeric, e.g. "X5KNN")
# ------------------------------------------------------------
LIST_ID=""
for days_back in 1 2 3; do
    list_date="$(date -u -d "$days_back days ago" +%F)"
    candidate="$(curl -fsS --max-time 30 \
        "$TRANCO_BASE/daily_list_id?date=$list_date&subdomains=false" 2>/dev/null \
        | tr -cd 'A-Za-z0-9' || true)"
    if [ -n "$candidate" ]; then
        LIST_ID="$candidate"
        log "list id $LIST_ID (date $list_date)"
        break
    fi
done

# ------------------------------------------------------------
# Step 2 — download top N
# ------------------------------------------------------------
CSV="$WORK_DIR/top.csv"
if [ -n "$LIST_ID" ]; then
    curl -fsSL --retry 3 --retry-delay 30 --max-time 300 \
        -o "$WORK_DIR/raw.csv" "$TRANCO_BASE/download/$LIST_ID/$TOP_N"
else
    log "list id endpoint unavailable - falling back to top-1m.csv.zip"
    curl -fsSL --retry 3 --retry-delay 30 --max-time 600 \
        -o "$WORK_DIR/list.zip" "$TRANCO_BASE/top-1m.csv.zip"
    # Extract to a file first: `unzip | head` would fail under pipefail
    # (SIGPIPE on unzip once head stops reading).
    unzip -p "$WORK_DIR/list.zip" > "$WORK_DIR/full.csv"
    head -n "$TOP_N" "$WORK_DIR/full.csv" > "$WORK_DIR/raw.csv"
fi

# Tranco CSV uses CRLF; COPY rejects mixed line endings.
tr -d '\r' < "$WORK_DIR/raw.csv" > "$CSV"

ROWS="$(wc -l < "$CSV")"
log "downloaded $ROWS rows"
if [ "$ROWS" -lt "$MIN_ROWS" ]; then
    log "ERROR: only $ROWS rows (< $MIN_ROWS) - not loading, live allow-list unchanged"
    exit 1
fi

# ------------------------------------------------------------
# Step 3 — stage + delta apply
# ------------------------------------------------------------
psql_exec -c "TRUNCATE cyber_sentinel_ai.domain_allowlist_staging;"
psql_exec -c "\copy cyber_sentinel_ai.domain_allowlist_staging (rank, domain) FROM pstdin WITH (FORMAT csv)" < "$CSV"

# LIST_ID is sanitised to [A-Za-z0-9] above, safe to inline.
RESULT="$(psql_exec -c "SELECT r->>'status', r::text FROM (SELECT cyber_sentinel_ai.sp_sync_domain_allowlist('tranco', NULLIF('$LIST_ID', ''), $MIN_ROWS) AS r) x;")"
STATUS="${RESULT%%|*}"
log "result: ${RESULT#*|}"

if [ "$STATUS" != "ok" ]; then
    log "ERROR: sync aborted by database guard"
    exit 2
fi

log "done"
